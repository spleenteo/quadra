                  "fill": "$text-dim",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "You shoot a book page from an angle. A sign leans. A horizon drifts a few degrees. Fixing it is simple geometry, but the tools for it hide inside heavyweight editors, or behind websites that want your upload first.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-ui",
                  "fontSize": 18
                },
